---
import { Image } from "astro:assets";
import ServicesWhy from "./Services_Why.astro";
import serviceImage from "@images/45-personal-training.jpg";
import ServicesCTA from "./Services_CTA.astro";
---

<section>
    <div class="container">
        <div class="text-section">
            <h2>Personal Training for Over 45's on the Central Coast</h2>
            <p>
                Our personal training sessions for over 45’s are built to help
                you move better, feel stronger and stay active without the
                stress of a crowded gym. These sessions are tailored to your
                current fitness level, goals and any past injuries.
            </p>
            <p>
                You’ll work 1-on-1 with an experienced and qualified coach who
                understands the importance of mobility, strength, and injury
                prevention at this stage of life. Whether you're getting back
                into fitness or looking to maintain performance, our sessions
                are all about progress at your pace.
            </p>
        </div>

        <Image
            src={serviceImage}
            alt="1v1 soccer training central coast"
            class="service-image"
        />

        <div class="why-section">
            <h3>Why Train with Soccer Everyday Academy</h3>
            <ServicesWhy
                variant="light"
                whyArray={[
                    {
                        title: "Tailored for You",
                        text: "We don’t use cookie-cutter programs. Every session is personalised to suit your body, lifestyle and goals.",
                    },
                    {
                        title: "Focus on Strength, Mobility and Longevity",
                        text: "Sessions help you move better in day-to-day life, improve core strength, and reduce risk of injury as you age.",
                    },
                    {
                        title: "Comfortable, Encouraging Setting",
                        text: "Train without the pressure of a gym. The sessions we offer are private, respectful and designed to make you feel confident in your training.",
                    },
                ]}
            />
        </div>
        <div class="cta-section">
            <ServicesCTA
                variant="dark"
                title="Strong Body, Clear Mind – PT at SEA"
                text="Get in touch and book your first session. Train with purpose and build a stronger version of yourself – one session at a time."
            />
        </div>
    </div>
</section>

<style>
    .container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    h2 {
        font-size: 2em;
    }
    h3 {
        font-size: 1.5em;
        text-align: center;
    }
    .service-image {
        width: 100%;
        height: auto;
    }
    .text-section {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .why-section {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-top: 4rem;
    }
    .cta-section {
        margin-top: 2rem;
    }
    @media (min-width: 768px) {
        .text-section {
            grid-area: 1 / 1 / 2 / 3;
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto;
        }
        .text-section h2 {
            grid-area: 1 / 1 / 2 / 3;
            text-align: center;
            font-size: 2.5em;
        }
        h3 {
            font-size: 1.8em;
        }
        .text-section p:nth-of-type(1) {
            grid-area: 2 / 1 / 3 / 2;
        }
        .text-section p:nth-of-type(2) {
            grid-area: 2 / 2 / 3 / 3;
        }

        .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto auto;
        }

        .service-image {
            grid-area: 2 / 1 / 3 / 2;
            height: 100%;
            object-fit: cover;
        }

        .cta-section {
            grid-area: 2 / 2 / 3 / 3;
            margin-top: 0px;
        }

        .why-section {
            grid-area: 3 / 1 / 4 / 3;
        }
    }

    @media (min-width: 1024px) {
        .container {
            gap: 4rem;
        }
        .text-section {
            gap: 4rem;
        }
    }

    @media (min-width: 1440px) {
        .text-section {
            grid-area: 1 / 1 / 2 / 4;
            grid-template-columns: 1fr 1fr 1fr;
            grid-template-rows: 1fr 1fr;
            gap: 2rem;
        }

        .container {
            grid-template-columns: 1fr 1fr 1fr;
            gap: 2rem;
            row-gap: 4rem;
        }
        .text-section h2 {
            grid-area: 1 / 1 / 2 / 3;
            text-align: left;
            font-size: 4em;
        }
        h3 {
            font-size: 2em;
        }
        .service-image {
            grid-area: 1 / 3 / 2 /4;
            height: 100%;
            object-fit: cover;
        }

        .cta-section {
            grid-area: 2 / 3 / 3 / 4;
            margin-top: 0px;
        }

        .why-section {
            grid-area: 2 / 1 / 4 / 3;
            margin-top: 0px;
        }
        h3 {
            text-align: left;
        }
    }
</style>
