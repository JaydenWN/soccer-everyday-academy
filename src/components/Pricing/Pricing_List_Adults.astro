---
import PricingCard from "./Pricing_Card.astro";
import PrimaryButton from "../common/Primary_Button.astro";
import ContactIcon from "@icons/calander-black.svg";
---

<section>
    <div class="container">
        <h2>Classes for Adults (Over 45's)</h2>
        <div class="pricing-cards">
            <PricingCard
                title="Personal Training Mobility and Strength"
                list={[
                    "Strength",
                    "Mobility",
                    "Nutrition",
                    "Mobility",
                    "Complete Evaluation",
                    "75 Minute Session",
                ]}
            >
                <div slot="price">
                    <p><strong>$65 Per Session</strong></p>
                    <p>or</p>
                    <p><strong>8 Sessions for $480</strong></p>
                </div>

                <div slot="buttons" class="button-group">
                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/adult-pt-training-1v1-single"
                        text="Book Single Session"
                        variant="yellow"
                        icon={ContactIcon}
                    />

                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/adult-pt-training-1v1-8-sessions"
                        text="Book 8 Sessions"
                        variant="yellow"
                        icon={ContactIcon}
                    />
                </div>
            </PricingCard>

            <PricingCard
                title="Small Group Package"
                list={[
                    "Strength",
                    "Mobility",
                    "Nutrition",
                    "Mobility",
                    "Complete Evaluation",
                    "75 Minute Session",
                ]}
            >
                <div slot="price">
                    <p><strong>$325</strong></p>
                    <p>1 Day / (8 Weeks)</p>
                    <p><strong>$555</strong></p>
                    <p>2 Days / (8 Weeks)</p>
                    <small>Max 4 People. Min 8 Weeks.</small>
                </div>
                <div slot="buttons" class="button-group">
                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/personal-training-group-1-day"
                        text="Book 1 Day Per Week"
                        variant="yellow"
                        icon={ContactIcon}
                    />

                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/personal-training-group-2-days"
                        text="Book 2 Days Per Week"
                        variant="yellow"
                        icon={ContactIcon}
                    />
                </div>
            </PricingCard>

            <div class="button-group" slot="buttons">
                <PricingCard
                    title="Single Group Session"
                    list={[
                        "Train with Others",
                        "Strength",
                        "Nutrition",
                        "Mobility",
                        "Individual Feedback",
                        "75 Minute Session",
                    ]}
                    link="https://calendly.com/soccereverydayacademy-info/adult-small-group"
                >
                    <div slot="price">
                        <p><strong>$50</strong></p>
                    </div>
                    <div slot="buttons" class="button-group">
                        <PrimaryButton
                            calendly={true}
                            link="https://calendly.com/soccereverydayacademy-info/personal-training-one-off"
                            text="Book Single Session"
                            variant="yellow"
                            icon={ContactIcon}
                        />
                    </div>
                </PricingCard>
            </div>
        </div>
    </div>
</section>

<style>
    section {
        background-color: #fcfafa;
    }
    .container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .pricing-cards {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    h2 {
        text-align: center;
        background-color: var(--grey);
        padding: 1rem 1rem 0.8rem 1rem;
        font-size: 2em;
    }
    .button-group {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }
    @media (min-width: 768px) {
        .pricing-cards {
            gap: 1rem;
            flex-direction: row;
            flex-wrap: wrap;
        }
        .button-group {
            justify-content: start;
            padding: 0px 1rem;
            gap: 0.5rem;
        }
    }
    @media (min-width: 1024px) {
        .button-group {
            justify-content: start;
            padding: 0px 2rem;
            gap: 0.5rem;
        }
    }
    @media (min-width: 1440px) {
        .pricing-cards {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
        }
    }
</style>
