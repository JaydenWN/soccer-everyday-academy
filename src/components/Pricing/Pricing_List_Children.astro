---
import PrimaryButton from "../common/Primary_Button.astro";
import PricingCard from "./Pricing_Card.astro";
import ContactIcon from "@icons/calander-black.svg";
---

<section>
    <div class="container">
        <h2>Soccer Classes for Adults and Kids 10+</h2>
        <div class="pricing-cards">
            <PricingCard
                title="1v1 Personal Training"
                list={[
                    "Strength",
                    "Mobility",
                    "Nutrition",
                    "Mobility",
                    "Complete Evaluation",
                    "75 Minute Session",
                ]}
            >
                <div slot="price">
                    <p><strong>$65 Per Hour</strong></p>
                    <p>or</p>
                    <p><strong>8 Sessions for $480</strong></p>
                </div>

                <div slot="buttons" class="button-group">
                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/soccer-1v1-1-day"
                        text="Book Single Session"
                        variant="yellow"
                        icon={ContactIcon}
                    />

                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/soccer-1v1-2-day"
                        text="Book 8 Sessions"
                        variant="yellow"
                        icon={ContactIcon}
                    />
                </div>
            </PricingCard>

            <PricingCard
                title="Small Group Package"
                list={[
                    "Strength",
                    "Mobility",
                    "Nutrition",
                    "Mobility",
                    "Complete Evaluation",
                    "75 Minute Session",
                ]}
            >
                <div slot="price">
                    <p><strong>$325</strong></p>
                    <p>1 Day / (8 Weeks)</p>
                    <p><strong>$555</strong></p>
                    <p>2 Days / (8 Weeks)</p>
                    <small>Max 4 People. Min 8 Weeks.</small>
                </div>

                <div slot="buttons" class="button-group">
                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/soccer-small-group"
                        text="Book 1 Day Per Week"
                        variant="yellow"
                        icon={ContactIcon}
                    />

                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/soccer-small-group-2-days"
                        text="Book 2 Days Per Week"
                        variant="yellow"
                        icon={ContactIcon}
                    />
                </div>
            </PricingCard>

            <PricingCard
                title="Strength & Conditioning"
                list={[
                    "4 People Sessions",
                    "Speed",
                    "Agility",
                    "Core",
                    "Boost Performance",
                    "75 Minute Session",
                ]}
            >
                <div slot="price">
                    <p><strong>$325</strong></p>
                    <p>1 Day / (8 Weeks)</p>
                    <p><strong>$555</strong></p>
                    <p>2 Days / (8 Weeks)</p>
                </div>
                <div slot="buttons" class="button-group">
                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/strength-conditioning-1-day"
                        text="Book 1 Day Per Week"
                        variant="yellow"
                        icon={ContactIcon}
                    />

                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/strength-conditioning-2-days"
                        text="Book 2 Days Per Week"
                        variant="yellow"
                        icon={ContactIcon}
                    />
                </div>
            </PricingCard>

            <PricingCard
                title="Holiday football clinics"
                list={[
                    "Small Groups",
                    "Skills-Based Drills",
                    "Game Scenarios",
                    "Tactical Awareness",
                    "Build Confidence",
                ]}
            >
                <div slot="price">
                    <p><strong>$225</strong></p>
                    <p>3 Days</p>
                </div>
                <div slot="buttons" class="button-group">
                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/football-clinic"
                        text="Book Now"
                        variant="yellow"
                        icon={ContactIcon}
                    />
                </div>
            </PricingCard>

            <PricingCard
                title="Soccer Coach Courses"
                list={[
                    "Practical Football Education",
                    "Learn to Lead, Motivate & Develop",
                    "Ideal for Parents & Aspiring Coaches",
                ]}
            >
                <div slot="price">
                    <p><strong>Contact For Pricing</strong></p>
                </div>
            </PricingCard>

            <PricingCard
                title="Soccer Tournaments"
                list={[
                    "Acquisition skills",
                    "Tactical skills",
                    "Video analysis",
                    "Tactical Awareness",
                    "Play like a Pro",
                ]}
            >
                <div slot="price">
                    <p><strong>$560</strong></p>
                    <p>2 Days Per Week for 8 Weeks</p>
                </div>
                <div slot="buttons" class="button-group">
                    <PrimaryButton
                        calendly={true}
                        link="https://calendly.com/soccereverydayacademy-info/soccer-tournament"
                        text="Book Now"
                        variant="yellow"
                        icon={ContactIcon}
                    />
                    <PrimaryButton
                        link="/soccer-tournaments"
                        text="More Info"
                        variant="default"
                    />
                </div>
            </PricingCard>
        </div>
    </div>
</section>

<style>
    .container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .pricing-cards {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    h2 {
        text-align: center;
        background-color: var(--grey);
        padding: 1rem 1rem 0.8rem 1rem;
        font-size: 2em;
    }
    .button-group {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }
    @media (min-width: 768px) {
        .pricing-cards {
            gap: 1rem;
            flex-direction: row;
            flex-wrap: wrap;
        }
        .button-group {
            justify-content: start;
            padding: 0px 1rem;
            gap: 0.5rem;
        }
    }
    @media (min-width: 1024px) {
        .button-group {
            justify-content: start;
            padding: 0px 2rem;
            gap: 0.5rem;
        }
    }
    @media (min-width: 1440px) {
        .pricing-cards {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
        }
    }
</style>
