---
import PrimaryButton from "./Primary_Button.astro";
---

<dialog id="popup" aria-label="Tournament recruitment notice">
    <p>Training is game and game is war</p>
    <p>
        We are looking for <strong>12 players </strong>to play at competition
        level in tournaments around the <strong>Central Coast and Sydney</strong
        >
    </p>
    <div class="buttons">
        <PrimaryButton
            link="/soccer-tournaments"
            text="Apply Now"
            variant="yellow"
        />
        <button class="close-btn" id="closeBtn">Close</button>
    </div>
</dialog>

<style>
    dialog[open] {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        position: fixed;
        inset-inline: 0; /* left and right */
        top: 58px;
        margin: 0; /* remove default centering margin */
        width: 100%;
        box-sizing: border-box;
        border: none;
        padding: 16px;
        background: rebeccapurple;
        color: white;
        box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.15);
        z-index: 1000;
    }

    .close-btn {
        padding: 10px 16px;
        font-size: 1em;
        border: 0;
        background: var(--dark);
        color: #fff;
        cursor: pointer;
        font-family: "paragraph";
        text-transform: uppercase;
        max-height: fit-content;
    }

    p {
        line-height: normal;
    }
    p:first-of-type {
        font-family: "heading";
        font-size: 1.8em;
    }

    .buttons {
        display: flex;
        gap: 1rem;
        margin-top: 1em;
    }

    @media (min-width: 768px) {
        dialog[open] {
            padding: 2rem;
        }
    }
    @media (min-width: 1024px) {
        dialog[open] {
            padding: 2rem 4rem;
        }
    }
    @media (min-width: 1440px) {
        @media (min-width: 1024px) {
            dialog[open] {
                padding: 2rem 6rem;
            }
        }
    }
</style>

<script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
        const KEY = "sea_popup_dismissed"; // change key if you run multiple promos
        const dialog = document.getElementById("popup");
        const closeBtn = document.getElementById("closeBtn");

        // Only show if not dismissed this session
        const dismissed =
            sessionStorage.getItem(KEY) === "1" ||
            localStorage.getItem(KEY) === "1"; // guards you if you later switch storage

        if (!dismissed) {
            // Use non-modal open so our fixed-bottom styling holds and no backdrop shows
            if (typeof dialog.show === "function") dialog.show();
            else dialog.setAttribute("open", "");
        } else {
            // Optional: remove it entirely if already dismissed
            dialog.remove();
            return;
        }

        function dismiss() {
            try {
                // Keeps it closed across page navigations in this session
                sessionStorage.setItem(KEY, "1");
                // If you want it to stay closed across future visits, use localStorage instead:
                // localStorage.setItem(KEY, "1");
            } catch {}
            dialog.close();
        }

        closeBtn?.addEventListener("click", dismiss);

        // Let ESC close it and remember the choice
        dialog.addEventListener("cancel", (e) => {
            e.preventDefault();
            dismiss();
        });
    });
</script>
