---
import { Image } from "astro:assets";
import PrimaryButton from "../common/Primary_Button.astro";
import SecondaryButton from "../common/Secondary_Button.astro";
import heroImage from "@images/soccer-central-coast-hero.webp";
import callIcon from "@icons/phone-white.svg";
import contactIcon from "@icons/contact-black.svg";
import Logo from "@images/logo.svg";
---

<header>
    <Image src={heroImage} alt="title" class="hero-image" />
    <div class="container">
        <h1>Central Coast Soccer Coaching for Kids, Teens and Adults.</h1>
        <div class="logo-section">
            <Logo class="logo" />
            <h2>Serious About Football</h2>
        </div>
        <p>
            <strong>Soccer Everyday Academy </strong>offers expert football
            coaching across the Central Coast. We run one-on-one and small group
            sessions for all ages, with a focus on skill, confidence and game
            understanding. Backed by global experience and <strong
                >sports science</strong
            >, we coach with purpose and passion.
        </p>
        <div class="cta-buttons">
            <SecondaryButton
                link="tel:0432 275 674"
                text="Call Us"
                icon={callIcon}
            />
            <PrimaryButton
                link="/contact-soccer-every-day-academy/#contact"
                text="Book a session"
                icon={contactIcon}
                variant="yellow"
            />
        </div>
    </div>
</header>

<style>
    header {
        position: relative;
    }
    .hero-image {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
    }
    .container {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        color: white;
    }
    h1 {
        font-size: 2.6em;
    }

    .cta-buttons {
        display: flex;
        gap: 1rem;
    }

    .logo-section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

    .logo-section h2 {
        font-size: 1.85em;
    }

    .logo {
        width: 30%;
        height: auto;
    }

    @media (min-width: 768px) {
        h1 {
            grid-area: 1 / 1 / 2 / 3;
        }
        p {
            width: 80%;
            grid-area: 2 / 1 / 3 / 2;
        }
        .logo-section {
            text-align: center;
            margin: 0px auto;
            align-items: center;
            justify-content: center;
        }
        .logo {
            width: 150px;
        }
        .cta-buttons {
            grid-area: 3 / 1 / 4 / 3;
        }
        .container {
            gap: 3rem;
            display: grid;
            grid-template-columns: 2fr 1fr;
        }
    }

    @media (min-width: 1024px) {
        .container {
            gap: 4rem;
        }
    }

    @media (min-width: 1440px) {
        h1 {
            font-size: 4em;
            grid-area: 1 / 1 / 2 / 2;
        }
        .logo-section {
            grid-area: 1 / 2 / 4 / 3;
        }
    }
</style>
